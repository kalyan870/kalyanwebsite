rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Primitive Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints (Phase 4) ---
    function isValidUserProfile(data, expectedUid) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == expectedUid
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, expectedUid) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == expectedUid
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidProjectBookmark(data) {
      return data.keys().hasAll(['uid', 'projectId', 'projectTitle', 'category', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'projectId', 'projectTitle', 'category', 'note', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.projectId is string
        && data.projectId.size() >= 1
        && data.projectId.size() <= 100
        && data.projectId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.projectTitle is string
        && data.projectTitle.size() >= 1
        && data.projectTitle.size() <= 140
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.note is string
        && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiLabSession(data) {
      return data.keys().hasAll(['uid', 'mode', 'model', 'title', 'lastPrompt', 'lastResponse', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'mode', 'model', 'title', 'lastPrompt', 'lastResponse', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.mode is string
        && data.mode in ['chat', 'search', 'video']
        && data.model is string
        && data.model.size() >= 1
        && data.model.size() <= 64
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.lastPrompt is string
        && data.lastPrompt.size() >= 1
        && data.lastPrompt.size() <= 1000
        && data.lastResponse is string
        && data.lastResponse.size() <= 4000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time
          && (exists(/databases/$(database)/documents/users/$(userId))
              || existsAfter(/databases/$(database)/documents/users/$(userId)));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if false;
      }
    }

    match /bookmarks/{bookmarkId} {
      allow get: if isValidId(bookmarkId) && isVerifiedUser() && existing().uid == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.uid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(bookmarkId)
        && isValidProjectBookmark(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(bookmarkId)
        && existing().uid == request.auth.uid
        && isValidProjectBookmark(incoming())
        && incoming().uid == existing().uid
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'projectTitle', 'category', 'updatedAt']);

      allow delete: if isValidId(bookmarkId) && isVerifiedUser() && existing().uid == request.auth.uid;
    }

    match /aiSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isVerifiedUser() && existing().uid == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.uid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(sessionId)
        && isValidAiLabSession(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(sessionId)
        && existing().uid == request.auth.uid
        && isValidAiLabSession(incoming())
        && incoming().uid == existing().uid
        && incoming().mode == existing().mode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['model', 'title', 'lastPrompt', 'lastResponse', 'updatedAt']);

      allow delete: if isValidId(sessionId) && isVerifiedUser() && existing().uid == request.auth.uid;
    }
  }
}
